pipeline {
   tools {
     maven 'Maven_3.9'
    }
   agent any
      stages{
       stage('Git') {
             steps {
               sh 'cleanWs()'
             }
        }
         stage('Git checkout'){
            steps {
               checkout changelog: false, poll: false, scm: scmGit(branches: [[name: '*/feature-medinat']], extensions: [], userRemoteConfigs: [[credentialsId: 'ibt-medinat-student', url: 'https://github.com/IBT-learning/hello-maven']])
            }
         }
         stage('Validate'){
              steps{
                 withMaven(maven: 'Maven_3.9') {
                     sh 'mvn validate'
                 }
              }
         }
         stage('compile'){
               steps{
                   withMaven(maven: 'Maven_3.9') {
                      sh 'mvn compile'
                   }
               }
         }
         stage('test'){
               steps{
                   withMaven(maven: 'Maven_3.9') {
                       sh 'mvn test'
                   }
               }
         }
         stage('SonarQube Analysis') {
                  environment{
                    sonarScan= tool 'sonar-scanner'
                  }
                 steps{
                   withSonarQubeEnv(credentialsId: 'sonar-token', installationName:'sonar-server') {
                           sh "${env.sonarScan}/bin/sonar-scanner "
                   }
                 }
         }
         stage('package'){
               steps{
                   withMaven(maven: 'Maven_3.9') {
                         sh 'mvn package'
                   }
               }
         }
        stage('owasp-scan'){
                    steps{
                       dependencyCheck additionalArguments:'--scan ./ ',odcInstallation:"OWASP-dependency-check"
                       dependencyCheckPublisher pattern: "**/dependency-check-report.xml"
                    }
        }

      }
}
